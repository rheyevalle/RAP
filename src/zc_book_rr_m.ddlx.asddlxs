@Metadata.layer: #CORE
//@Search.searchable: true
@UI.headerInfo: {
    typeName: 'Booking',
    typeNamePlural: 'Bookings',
    title: {
        type: #STANDARD,
        label: 'Booking',
        value: 'BookingId'
    }
}
annotate view ZC_BOOK_RR_M with
{
  @UI.facet: [{ // First tab of Object Page
       id: 'Booking',
       purpose: #STANDARD,
       position: 10,
       label: 'Booking',
       type: #IDENTIFICATION_REFERENCE
   },
   { // Second tab of Object Page
       id: 'BookingSuppl',
       purpose: #STANDARD,
       position: 20,
       label: 'Booking Supplement',
       type: #LINEITEM_REFERENCE,
       targetElement: '_BookSuppl'
   }]
   //   TravelId;
  @UI.lineItem: [{ position: 10  }]
  @UI.identification: [{ position: 10  }]
  BookingId;
  @UI.lineItem: [{ position: 20  }]
  @UI.identification: [{ position: 20  }]
  BookingDate;
  @UI.lineItem: [{ position: 30  }]
  @UI.identification: [{ position: 30  }]
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{
    entity: {
        name: '/DMO/I_Customer',
        element: 'CustomerID'
    }
  }]
  CustomerId;
  @UI.lineItem: [{ position: 40  }]
  @UI.identification: [{ position: 40  }]
  @Consumption.valueHelpDefinition: [{
     entity: {
         name: '/DMO/I_Carrier',
         element: 'AirlineID'
     }}]
  CarrierId;
  @UI.lineItem: [{ position: 50  }]
  @UI.identification: [{ position: 50  }]
  @Consumption.valueHelpDefinition: [{
    entity: {
        name: '/DMO/I_Flight',
        element: 'ConnectionID'
    },
    additionalBinding:[ { element:  'ConnectionID',     // get this from reference cds
                          localElement: 'ConnectionId' },   //get this from here
                          { element:  'AirlineID',
                          localElement: 'CarrierId' },
                          { element:  'CurrencyCode',
                          localElement: 'CurrencyCode' },
                          { element:  'Price',              // get this from reference cds
                          localElement: 'FlightPrice' }]   //get this from here
  }]
  ConnectionId;
  @UI.lineItem: [{ position: 60  }]
  @UI.identification: [{ position: 60  }]
  @Consumption.valueHelpDefinition: [{
   entity: {
       name: '/DMO/I_Flight',
       element: 'FlightDate'
   },
      additionalBinding:[ { element:  'FlightDate',     // get this from reference cds
                        localElement: 'FlightDate' },   //get this from here
                        { element:  'AirlineID',
                        localElement: 'CarrierId' },
                        { element:  'CurrencyCode',
                        localElement: 'CurrencyCode' },
                        { element:  'Price',              // get this from reference cds
                        localElement: 'FlightPrice' }]   //get this from here
   }]
  FlightDate;
  @UI.lineItem: [{ position: 70  }]
  @UI.identification: [{ position: 70  }]
  FlightPrice;
  @UI.hidden: true
  @Consumption.valueHelpDefinition: [{
  entity: {
     name: 'I_Currency',
     element: 'Currency'
  }
  }]
  CurrencyCode;
  @UI.lineItem: [{ position: 80  }]
  @UI.identification: [{ position: 80  }]
  @UI.textArrangement: #TEXT_ONLY
  @Consumption.valueHelpDefinition: [{
     entity: {
         name: '/DMO/I_Booking_Status_VH',
         element: 'BookingStatus'
     }}]
  BookingStatus;
  @UI.hidden: true
  LastChangedAt;

}